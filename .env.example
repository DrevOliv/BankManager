# Copy to .env and adjust: cp .env.example .env

# Password for the internal Postgres database (pick something long and random).
POSTGRES_PASSWORD=change-me-to-something-long

# Port the web app is published on: http://<server>:8080
APP_PORT=8080

# Your Ollama server. host.docker.internal is the machine running Docker;
# use e.g. http://192.168.1.50:11434 if Ollama runs on another computer.
# Both can also be changed later on the Settings page.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# Set both to true when the app sits behind an HTTPS reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false

TZ=Europe/Stockholm
